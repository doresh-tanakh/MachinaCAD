{
  "name": "olplotcad",
  "version": "0.2.26",
  "description": "OlplotCAD 2D CAD and electronic design editors",
  "main": "main.cjs",
  "author": "OlplotCAD contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac pkg",
    "build:win": "electron-builder --win nsis --x64",
    "build:mac:arm64": "electron-builder --mac pkg --arm64",
    "build:mac:x64": "electron-builder --mac pkg --x64"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.olplotcad.desktop",
    "productName": "OlplotCAD",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "app.js",
      "style.css",
      "logo.svg",
      "main.cjs",
      "dxf.js",
      "symbols.js",
      "circuit.js",
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt",
      "licenses/**/*",
      "spline.js",
      "polyline.js",
      "mtext.js",
      "hatch.js",
      "cadstyle.js",
      "hatchcurve.js",
      "angular.js",
      "schematic.js",
      "architecture.js",
      "pcb.js",
      "fabrication.js",
      "ac.js",
      "walls.js",
      "boardlink.js",
      "editor-policy.js",
      "editors.js",
      "spice.js",
      "kicad.js",
      "vendor/clipper.js",
      "copper.js",
      "zones.js"
    ],
    "mac": {
      "target": [
        "pkg"
      ],
      "category": "public.app-category.productivity",
      "icon": "icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
